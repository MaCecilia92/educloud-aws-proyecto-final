{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerSoloElSecretoDeReportes",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:<ID_DE_CUENTA>:secret:educloud/rds/reportes-*"
    },
    {
      "Sid": "EnviarElReportePorCorreo",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "*",
      "Condition": { "StringEquals": { "ses:FromAddress": "reportes@educloud.example" } }
    }
  ]
}
